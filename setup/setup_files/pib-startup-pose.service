[Unit]
Description=Move pib through its startup and poweroff pose sequence
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=pib
Group=pib
ExecStart=/home/pib/app/pib-backend/setup/run-startup-poweroff-pose.sh
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
